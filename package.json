{
  "name": "agentic-n8n",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "factory": "./bin/factory.mjs"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:image": "node scripts/check-docker-image-size.mjs",
    "test:observability-smoke": "node scripts/observability-smoke.mjs",
    "test:temporal-smoke": "node scripts/temporal-smoke.mjs",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "tsx scripts/demo.ts",
    "factory": "tsx scripts/factory.ts",
    "dev": "node scripts/dev.mjs",
    "server": "tsx src/server/main.ts",
    "test": "vitest run",
    "test:coding-workflow": "vitest run src/server/coding-workflow.e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/temporal/worker.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@noble/hashes": "2.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@temporalio/activity": "1.22.0",
    "@temporalio/client": "1.22.0",
    "@temporalio/worker": "1.22.0",
    "@temporalio/workflow": "1.22.0",
    "fastify": "5.12.1",
    "openai": "^7.13.0",
    "pg": "^8.16.3",
    "yaml": "^2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.2.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@xyflow/react": "12.11.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
